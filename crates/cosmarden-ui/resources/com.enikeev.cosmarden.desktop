[Desktop Entry]
Name=Cosmarden
Comment=Bitwarden-compatible password manager for COSMIC DE
Exec=cosmarden-applet
Icon=com.enikeev.cosmarden-symbolic
Terminal=false
StartupNotify=true
Type=Application
Categories=Cosmic;Utility;Security;
Keywords=Cosmic;Panel;Applet;Bitwarden;Password;
OnlyShowIn=COSMIC;
StartupWMClass=com.enikeev.cosmarden
X-CosmicApplet=true
X-CosmicShrinkable=true
X-CosmicHoverPopup=Auto
X-OverflowPriority=10
