# Template for browser-extension/.env — the local, gitignored secrets file
# loaded by `just sign-extension` (via packaging/load-ext-env.sh).
#
# Copy this file to .env in the same directory and fill in real values:
#   cp browser-extension/.env.example browser-extension/.env
#   chmod 600 browser-extension/.env
#
# Format: plain KEY=VALUE lines only — no quotes, no spaces around `=`, no
# inline comments, no shell syntax. Values are exported literally and never
# evaluated. Variables already exported in your shell take precedence over
# this file.

# AMO API credentials — generate at https://addons.mozilla.org/developers/addon/api/key/
# WEB_EXT_API_KEY    = the JWT issuer shown on that page
# WEB_EXT_API_SECRET = the JWT secret shown on that page
WEB_EXT_API_KEY=
WEB_EXT_API_SECRET=

# Optional — self-hosted update base URL (plain https:// URL, no trailing
# slash). When set, the signed XPI carries the gecko update_url and
# dist/updates.json is updated in the same run.
#EXT_UPDATE_BASE_URL=

# Optional — signing timeout override in milliseconds. Covers the validation
# poll AND the wait for AMO approval (default 1800000 = 30 minutes; web-ext's
# own approval default is 15).
#EXT_SIGN_TIMEOUT_MS=1800000
