{
  "manifest_version": 3,
  "name": "COSMIC BWarden",
  "version": "0.1.0",
  "description": "Native COSMIC Bitwarden client extension",
  "homepage_url": "https://github.com/donatengit/cosmic-bwarden",
  "browser_specific_settings": {
    "gecko": {
      "id": "cosmic-bwarden@enikeev.com",
      "strict_min_version": "115.0"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background-save.js", "background.js"]
  },
  "icons": {
    "16": "icons/black16.png",
    "32": "icons/black32.png",
    "64": "icons/black64.png",
    "128": "icons/black128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/black16.png",
      "32": "icons/black32.png",
      "64": "icons/black64.png",
      "128": "icons/black128.png"
    }
  },
  "permissions": [
    "nativeMessaging",
    "tabs",
    "clipboardWrite",
    "contextMenus",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-heuristics.js", "content.js", "content-submit.js", "content-bar.js", "content-generate.js"],
      "run_at": "document_idle"
    }
  ]
}
