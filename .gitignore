# Generated build artifacts
/target/
 
# Cargo lock file — keep for binaries, exclude for libraries
# Cargo.lock
# .cargo/config.toml is machine-local (it sets -C prefer-dynamic), but
# audit.toml is the tracked, reviewed ignore list for `cargo audit` and must
# ship. A negation cannot re-include a file under an excluded *directory*, so
# exclude the contents rather than the directory itself.
.cargo/*
!.cargo/audit.toml

# Backup files from editors
*.orig
*.bk
*.swp
*~
 
# IDE and editor directories
.idea/
.vscode/
*.iml
 
# Environment files
.env
.env.*
!.env.example
 
# Profiling and coverage artifacts
perf.data
perf.data.old
callgrind.out.*
*.profraw
*.profdata
tarpaulin-report.html
lcov.info
 
# Benchmarking artifacts
criterion/
 
# cargo-fuzz
fuzz/target/
 
# cargo-expand output
*.expanded.rs

# Node / npm (browser-extension Playwright tests).
# No trailing slash: also matches the `node_modules` symlink the Playwright
# harness creates (a slash-suffixed pattern matches dirs only, not symlinks).
node_modules

# Playwright / test-runner output (any depth)
test-results/
playwright-report/
.playwright/
.last-run.json

# Temporary files
*.tmp
*.log
*.db
*.temp
 
# OS-specific
.DS_Store
Thumbs.db
desktop.ini

# Local reference-only checkouts (libcosmic, upstream cosmic applets, official
# Bitwarden clients, rbw) kept for reading during development. Not build
# dependencies: libcosmic is pulled via the Cargo git dependency in Cargo.toml.
# No slash suffix: also catches the dir if ever recreated as a symlink.
tmp_code_examples

# Reasonix agent workspace (session notes, plans, scratch)
.reasonix

# Claude Code local settings (machine-specific paths — see security review)
.claude

# Local scratch dir
tmp
