# Maintainer: Don Enikeev <donat@enikeev.net>
# AUR package skeleton for cosmarden.
# Before submitting to the AUR: cut a `vYYYY.MM.P` tag, replace the `SKIP`
# checksum with the real tarball sha256, and validate with
# `makepkg --printsrcinfo` plus a clean chroot build.

pkgname=cosmarden
pkgver=2026.07.0
pkgrel=1
pkgdesc="Bitwarden-compatible password manager for COSMIC DE"
arch=(x86_64)
url="https://github.com/donatengit/cosmic-bwarden"
license=(GPL-3.0-only)
depends=(libxkbcommon wayland mesa)
makedepends=(cargo just cmake pkgconf)
optdepends=(
  'tpm2-tss: PIN unlock sealed in the TPM'
  'firefox: browser-extension native messaging host'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP') # pin on first real release

build() {
  cd "$pkgname-$pkgver"
  # RUSTFLAGS replaces .cargo/config.toml's prefer-dynamic (incompatible with
  # the fat-LTO release profile); no target-cpu=native in distro packages.
  RUSTFLAGS="" cargo build --release --locked
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/cosmarden-agent "$pkgdir/usr/bin/cosmarden-agent"
  install -Dm755 target/release/cosmarden-applet "$pkgdir/usr/bin/cosmarden-applet"
  install -Dm755 target/release/cosmarden "$pkgdir/usr/bin/cosmarden"
  install -Dm644 crates/cosmarden-ui/resources/com.enikeev.cosmarden.desktop \
    "$pkgdir/usr/share/applications/com.enikeev.cosmarden.desktop"
  install -Dm644 crates/cosmarden-ui/resources/com.enikeev.cosmarden.metainfo.xml \
    "$pkgdir/usr/share/metainfo/com.enikeev.cosmarden.metainfo.xml"
  install -Dm644 packaging/com.enikeev.cosmarden.ron \
    "$pkgdir/usr/share/cosmic/applets/com.enikeev.cosmarden.ron"
  install -Dm644 packaging/cosmarden-agent.deb.service \
    "$pkgdir/usr/lib/systemd/user/cosmarden-agent.service"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
