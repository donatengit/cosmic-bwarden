#!/bin/sh
# Run the CI lint job (fmt + clippy) before a push that includes Rust.
# Clippy is a compile; skip when the pushed commits touch no Rust/Cargo files.
# Bypass with `git push --no-verify`.

zero=0000000000000000000000000000000000000000
need_lint=0
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue
    if [ "$remote_sha" = "$zero" ]; then
        range=$local_sha
    else
        range=$remote_sha..$local_sha
    fi
    if git diff --name-only "$range" | grep -qE '\.rs$|^Cargo\.(toml|lock)$'; then
        need_lint=1
    fi
done

if [ "$need_lint" -eq 0 ]; then
    exit 0
fi

if ! command -v just >/dev/null 2>&1; then
    echo "pre-push: just not found, skipping lint (CI will still run it)" >&2
    exit 0
fi

echo "pre-push: just lint (fmt + clippy, same as CI)" >&2
just lint
